{
  "name": "robot-bunnies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "node scripts/validate-content.mjs",
    "test": "npm run validate && npm run test:campaign && npm run test:mastery && npm run test:layouts",
    "test:campaign": "node scripts/test-campaign.mjs",
    "test:mastery": "node scripts/test-mastery.mjs",
    "test:layouts": "node scripts/test-layouts.mjs",
    "e2e": "node scripts/e2e-playthrough.cjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
